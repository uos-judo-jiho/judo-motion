{
  "name": "judo-motion",
  "version": "0.1.0",
  "private": true,
  "description": "GPU pixel-art judo technique animations as a web component",
  "homepage": "https://github.com/uos-judo-jiho/judo-motion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uos-judo-jiho/judo-motion.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./standalone": {
      "types": "./dist/index.d.ts",
      "default": "./dist/standalone.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "pnpm build:lib && pnpm build:app",
    "build:lib": "rm -rf dist && tsdown",
    "build:app": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings=0",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test",
    "export": "node --import tsx server/cli.ts",
    "prepack": "pnpm build:lib",
    "clean": "rm -rf dist dist-app"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "galmuri": "^2.40.3",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.22.0"
}

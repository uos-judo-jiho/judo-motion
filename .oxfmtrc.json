{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "arrowParens": "always",
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-app/**",
    "**/exports/**",
    "**/node_modules/**"
  ]
}
